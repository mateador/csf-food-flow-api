# Copy to .env for local development. Never commit the real .env file.
#
# In Azure Container Apps these are container environment variables.
# DATABASE_URL, JWT_SECRET and RESEND_API_KEY are stored as Container
# Apps secrets and referenced from their environment variables. DIRECT_URL
# is only used by migrate.py, which runs locally, so the container doesn't
# have it.

# --- Server ---
PORT=8000
# true locally: enables Sanic dev mode and drops the Secure flag on the
# session cookie so it works over plain http. Leave unset (or false) in
# production.
SANIC_DEV=true

# --- Database (Neon) ---
# Pooled connection string, used for normal app queries. Get this from your
# Neon project dashboard -> Connection Details -> "Pooled connection".
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require

# Direct (non-pooled) connection, used only for running migrations. Some
# poolers handle DDL statements (CREATE TABLE, ALTER TABLE) unreliably in
# transaction-pooling mode, so migrations connect directly instead.
# Neon dashboard -> Connection Details -> "Direct connection".
DIRECT_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- CORS ---
# Must be the PWA's exact origin, not a wildcard -- required because
# authentication uses httpOnly cookies, and cookies cannot be sent to/from
# a wildcard-origin CORS response.
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-real-random-secret

LOGIN_CODE_TTL_MINUTES=10
ACCESS_TOKEN_TTL_MINUTES=720

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty locally and login codes print to the console.
# Free tier: 3,000 emails/month, 100/day, 1 verified domain. Get your key at
# resend.com after verifying a sending domain.
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.org

# --- Seed script ---
# Email for the admin account created by `python -m src.db.seed`.
# Defaults to admin@example.org -- set your real address before seeding a
# fresh database.
SEED_ADMIN_EMAIL=admin@example.org